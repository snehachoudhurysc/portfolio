---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { artworks } from '../data/art';

const pad2 = (n: number) => String(n).padStart(2, '0');
const ratioNum = (r: string) => {
  const [w, h] = r.split('/').map(Number);
  return w / (h || 1);
};
// Portrait pieces sit narrower, landscape pieces wider.
const maxW = (r: string) => {
  const x = ratioNum(r);
  if (x < 0.78) return 580;
  if (x < 0.95) return 620;
  if (x < 1.2) return 720;
  if (x < 1.55) return 980;
  return 1000;
};

const works = artworks.map((a, i) => ({
  ...a,
  fig: 'Fig. ' + pad2(i + 1),
  caption: `— ${a.title}, ${a.year}, ${a.medium}`,
  maxW: maxW(a.ratio),
}));

// Only show the All / Paintings / Sketches toggle once there are both kinds.
const showFilter = new Set(artworks.map((a) => a.type)).size > 1;
const filters = [
  { id: 'all', label: 'All' },
  { id: 'painting', label: 'Paintings' },
  { id: 'sketch', label: 'Sketches' },
];
---

<Base title="Art" theme="dark" description={`Paintings and sketches by ${site.name}.`}>
  <div class="wrap gallery-page">
    <div class="head">
      <p class="eyebrow gal-eyebrow">The gallery</p>
      <h1 class="statement serif">{site.artistStatement}</h1>
      {showFilter && (
        <div class="filter" role="group" aria-label="Filter works">
          {filters.map((f, i) => (
            <button type="button" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>
          ))}
        </div>
      )}
    </div>

    <div class="works">
      {works.map((w, i) => (
        <figure class="work" data-type={w.type} style={`max-width:${w.maxW}px`}>
          <button
            type="button"
            class="work__btn"
            data-reveal="scale"
            data-index={i}
            style={`aspect-ratio:${w.ratio}`}
            aria-label={`View ${w.title} full screen`}
          >
            {w.image
              ? <img src={w.image} alt={`${w.title}, ${w.medium}, ${w.year}`} loading={i < 2 ? 'eager' : 'lazy'} />
              : <span class="ph ph--dark work__ph">{w.type} {pad2(i + 1)}</span>}
          </button>
          <figcaption data-reveal="up">
            <span class="fig serif">{w.fig}</span>
            <span>{w.caption}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>

  <dialog class="lb" aria-label="Artwork viewer">
    <div class="lb__top">
      <span class="lb__count"></span>
      <button type="button" class="lb__close">Close ✕</button>
    </div>
    <div class="lb__stage"><div class="lb__frame"></div></div>
    <div class="lb__bottom">
      <button type="button" class="lb__nav" data-step="-1">← Prev</button>
      <p class="lb__cap"><span class="fig serif"></span> <span class="lb__text"></span></p>
      <button type="button" class="lb__nav" data-step="1">Next →</button>
    </div>
  </dialog>

  <script define:vars={{ works: works.map(({ image, ratio, fig, caption, title, type }) => ({ image, ratio, fig, caption, title, type })) }}>
    const figures = [...document.querySelectorAll('.work')];
    const buttons = [...document.querySelectorAll('.filter button')];
    let visible = works.map((_, i) => i);

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        visible = [];
        figures.forEach((fig, i) => {
          const show = f === 'all' || fig.dataset.type === f;
          fig.hidden = !show;
          if (show) visible.push(i);
        });
      }),
    );

    const lb = document.querySelector('.lb');
    const frame = lb.querySelector('.lb__frame');
    const count = lb.querySelector('.lb__count');
    const capFig = lb.querySelector('.lb__cap .fig');
    const capText = lb.querySelector('.lb__text');
    let pos = 0;
    const pad2 = (n) => String(n).padStart(2, '0');

    const render = () => {
      const w = works[visible[pos]];
      count.textContent = `${pad2(pos + 1)} / ${pad2(visible.length)}`;
      capFig.textContent = w.fig;
      capText.textContent = w.caption;
      frame.style.aspectRatio = w.ratio;
      frame.innerHTML = '';
      if (w.image) {
        const img = document.createElement('img');
        img.src = w.image;
        img.alt = w.title;
        frame.append(img);
        frame.classList.remove('ph', 'ph--dark');
      } else {
        frame.classList.add('ph', 'ph--dark');
        frame.textContent = `${w.type} ${w.fig.slice(5)}`;
      }
    };
    const step = (d) => {
      pos = (pos + d + visible.length) % visible.length;
      render();
    };

    document.querySelectorAll('.work__btn').forEach((btn) =>
      btn.addEventListener('click', () => {
        pos = visible.indexOf(+btn.dataset.index);
        render();
        lb.showModal();
      }),
    );
    lb.querySelector('.lb__close').addEventListener('click', () => lb.close());
    lb.querySelectorAll('.lb__nav').forEach((b) => b.addEventListener('click', () => step(+b.dataset.step)));
    lb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') step(1);
      if (e.key === 'ArrowLeft') step(-1);
    });
  </script>
</Base>

<style>
  .gallery-page { padding-top: var(--sec-top); animation: scGallery 1.4s ease both; }

  .head {
    max-width: 980px; margin: 0 auto; text-align: center;
    animation: scFade 1.2s .3s ease both;
  }
  .gal-eyebrow { margin-bottom: 22px; color: var(--sage); letter-spacing: .18em; }
  .statement {
    margin: 0;
    font-style: italic; font-size: 52px; line-height: 1.1;
    text-wrap: balance;
  }
  .filter {
    display: inline-flex; gap: 4px; margin-top: 44px; padding: 4px;
    border: 1px solid rgba(245, 241, 232, .22); border-radius: 999px;
  }
  .filter button {
    background: transparent; color: var(--sage);
    border: 0; border-radius: 999px;
    padding: 10px 20px; min-height: 44px;
    font-size: 14px; font-weight: 500; cursor: pointer;
    transition: background .3s, color .3s;
  }
  .filter button:hover { color: var(--cream); }
  .filter button[aria-pressed='true'] { background: var(--wine); color: var(--cream); }

  .works {
    display: flex; flex-direction: column; align-items: center;
    gap: 180px; margin-top: 180px;
  }
  .work { margin: 0; width: 100%; }
  .work[hidden] { display: none; }
  .work__btn {
    display: block; width: 100%;
    padding: 0; border: 0; border-radius: 2px;
    background: var(--ph-dark);
    cursor: zoom-in;
    outline: 1px solid transparent; outline-offset: 8px;
  }
  .work__btn:hover { outline-color: var(--wine); }
  .work__btn img, .work__ph { width: 100%; height: 100%; object-fit: cover; border-radius: 2px; }
  .work__ph { font-size: 12px; }
  figcaption {
    margin-top: 20px;
    display: flex; flex-wrap: wrap; gap: 6px 14px; align-items: baseline;
    font-size: 14px; color: var(--sage);
  }
  .fig { font-style: italic; font-size: 20px; color: var(--cream); }

  /* Lightbox */
  .lb {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; border: 0;
    padding: 20px var(--pad);
    background: rgba(14, 7, 9, .97); color: var(--cream);
  }
  .lb[open] { display: flex; flex-direction: column; animation: scFade .3s ease both; }
  .lb::backdrop { background: rgba(14, 7, 9, .97); }
  .lb__top { display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: var(--sage); }
  .lb__close {
    background: none; border: 1px solid rgba(245, 241, 232, .4); color: var(--cream);
    border-radius: 999px; padding: 10px 18px; min-height: 44px; font-size: 14px; cursor: pointer;
  }
  .lb__close:hover { border-color: var(--wine); background: var(--wine); }
  .lb__stage {
    flex: 1; min-height: 0;
    display: flex; align-items: center; justify-content: center;
    padding: 24px 0;
  }
  .lb__frame { height: 100%; max-width: 100%; max-height: 100%; }
  .lb__frame :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .lb__bottom { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .lb__nav {
    background: none; border: 0; color: var(--cream);
    padding: 10px 0; min-height: 44px; font-size: 15px; cursor: pointer;
  }
  .lb__nav:hover { color: var(--sage); }
  .lb__cap { margin: 0; text-align: center; font-size: 14px; color: var(--sage); }

  @media (max-width: 759px) {
    .statement { font-size: 32px; }
    .works { gap: 96px; margin-top: 96px; }
    .work { max-width: 100% !important; }
  }
</style>
