---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { skills } from '../data/experience';

const chapters = [
  {
    n: '01', place: 'Dubai', title: 'Born and raised in Dubai.',
    text: 'I grew up in Dubai and first studied marketing in high school, which is where the interest started.',
    photo: '/photos/portrait.jpg', alt: 'Sneha Choudhury in a pinstripe blazer, arms crossed, smiling',
  },
  {
    n: '02', place: 'University of New Brunswick', title: 'A business degree, with honours.',
    text: "I completed a Bachelor of Business Administration at UNB with concentrations in Marketing and International Business, and made the Dean's List.",
    photo: '/photos/graduation.jpg', alt: 'Sneha receiving her degree from a faculty member at the UNB convocation ceremony',
  },
  {
    n: '03', place: 'Fredericton, now', title: 'What I bring.',
    text: 'Marketing and communications, business analysis and project coordination: campaign management, market research, data analysis and reporting across shipping, forestry and university research.',
    photo: '/photos/presenting.jpg', alt: 'Sneha presenting to a room in front of a large screen',
  },
];

const hobbies = [
  { label: 'Painting', shape: 'circle' },
  { label: 'Dancing', shape: 'diamond' },
  { label: 'Baking', shape: 'dome' },
  { label: 'Travelling', shape: 'square' },
];
---

<Base title="About">
  <div class="wrap page">
    <p class="eyebrow">About</p>
    <h1 class="sec-title">From Dubai to Fredericton, by way of a lot of <em class="wine">curiosity</em>.</h1>

    <div class="story">
      <div class="portrait-col">
        <div class="portrait">
          {chapters.map((c, i) => (
            <img
              class:list={['portrait__img', { 'is-on': i === 0 }]}
              data-photo={c.n}
              src={c.photo}
              alt={i === 0 ? c.alt : ''}
              width="1200" height="1200"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
          <span class="portrait__count"><span id="chapter-now">01</span> / 03</span>
        </div>
      </div>

      <div class="chapters">
        {chapters.map((c, i) => (
          <section class="chapter" data-chapter={c.n} data-reveal="up">
            <img class="chapter__photo" src={c.photo} alt={c.alt} width="1200" height="1200" loading="lazy" />
            <p class="chapter__eyebrow"><span class="wine">{c.n}</span>{c.place}</p>
            <h2 class="chapter__title serif">{c.title}</h2>
            <p class="chapter__text">{c.text}</p>
            {i === chapters.length - 1 && (
              <>
                <dl class="skills">
                  {skills.map((g) => (
                    <div class="skills__group">
                      <dt>{g.group}</dt>
                      <dd>{g.items.join(' · ')}</dd>
                    </div>
                  ))}
                </dl>
                <div class="sign-row">
                  {site.signature
                    ? <img class="sig" src={site.signature} alt="" />
                    : <div class="sig sig--ph">signature (SVG)</div>}
                  <a class="btn" href={site.cv} download>Download CV ↓</a>
                </div>
              </>
            )}
          </section>
        ))}
      </div>
    </div>

    <section class="outside">
      <h2 class="sub-title">Outside work</h2>
      <div class="cards">
        {hobbies.map((h) => (
          <div data-reveal="up">
            <div class="card">
              <span class={`shape shape--${h.shape}`}></span>
              <span class="card__label serif">{h.label}</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

<script>
  const now = document.getElementById('chapter-now');
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const n = (en.target as HTMLElement).dataset.chapter!;
        if (now) now.textContent = n;
        // Crossfade the sticky photo to match the chapter being read
        document.querySelectorAll<HTMLElement>('.portrait__img').forEach((img) => {
          img.classList.toggle('is-on', img.dataset.photo === n);
        });
      }),
    { rootMargin: '-45% 0px -45% 0px' },
  );
  document.querySelectorAll('[data-chapter]').forEach((el) => io.observe(el));
</script>

<style>
  .page { padding-top: var(--sec-top); }
  .sec-title { max-width: 1000px; }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--gap-l);
    align-items: start;
    margin-top: var(--gap-l);
  }
  .portrait-col { position: sticky; top: 110px; }
  .portrait { position: relative; aspect-ratio: 1 / 1; border-radius: 4px; overflow: hidden; }
  .portrait { background: var(--ph); }
  .portrait__img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transition: opacity .8s var(--ease);
  }
  .portrait__img.is-on { opacity: 1; }
  .portrait__count {
    position: absolute; right: 16px; bottom: 16px;
    padding: 4px 8px; border-radius: 999px; background: var(--cream);
    font-family: ui-monospace, Menlo, monospace; font-size: 12px; color: var(--wine);
  }
  .chapter__photo { display: none; }

  .chapters { display: flex; flex-direction: column; }
  .chapter {
    min-height: 560px;
    display: flex; flex-direction: column; justify-content: center;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }
  .chapter__eyebrow {
    margin: 0 0 16px;
    display: flex; gap: 14px; align-items: baseline;
    font-size: 13px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700;
    color: var(--muted);
  }
  .chapter__title { margin: 0; font-size: var(--fs-chapter); line-height: 1.02; }
  .chapter__text {
    margin: 20px 0 0;
    font-size: var(--fs-body); line-height: 1.6; max-width: 560px;
    text-wrap: pretty;
  }
  .skills { margin: 28px 0 0; max-width: 560px; }
  .skills__group { padding: 14px 0; border-top: 1px solid var(--line); }
  .skills dt {
    font-size: 12px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700;
    color: var(--muted);
  }
  .skills dd { margin: 6px 0 0; font-size: 15px; line-height: 1.6; }
  .sign-row { margin-top: 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 24px; }
  .sig { width: 200px; height: 72px; object-fit: contain; object-position: left; }
  .sig--ph {
    border-bottom: 1px solid var(--ink);
    background-image: repeating-linear-gradient(135deg, rgba(30, 30, 30, .07) 0 1px, transparent 1px 9px);
    display: flex; align-items: center; justify-content: center;
    font-family: ui-monospace, Menlo, monospace; font-size: 11px; color: var(--muted);
  }

  .outside { margin-top: var(--sec-gap); }
  .cards { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--gap-s); }
  .card {
    aspect-ratio: 1 / 1.1;
    border: 1px solid var(--line); border-radius: 6px;
    padding: 22px;
    display: flex; flex-direction: column; justify-content: space-between;
    transition: background .35s ease, transform .35s ease;
  }
  .card:hover { background: var(--sage-tint); transform: rotate(-1.5deg) translateY(-4px); }
  .card__label { font-size: 40px; line-height: 1; }
  .shape { display: block; }
  .shape--circle { width: 34px; height: 34px; border-radius: 50%; background: var(--wine); }
  .shape--diamond { width: 26px; height: 26px; margin: 4px; background: var(--sage); transform: rotate(45deg); }
  .shape--dome { width: 34px; height: 34px; border-radius: 34px 34px 0 0; background: var(--sage); }
  .shape--square { width: 30px; height: 30px; background: var(--wine); }

  @media (max-width: 759px) {
    .story { grid-template-columns: 1fr; }
    /* On phones each chapter carries its own photo instead of a sticky one */
    .portrait-col { display: none; }
    .chapter__photo {
      display: block; width: 100%; height: auto;
      aspect-ratio: 1 / 1; object-fit: cover;
      border-radius: 4px; margin-bottom: 24px;
    }
    .chapter { min-height: 0; }
    .cards { grid-template-columns: 1fr 1fr; }
    .card__label { font-size: 30px; }
  }
</style>
